# OrderPilot web: copy to .env.local and adjust. All values are public (inlined into the browser bundle).

# API base URLs (no trailing slash). core-api serves /api/*, ai-service serves /ai/*.
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# demo  = role picker → POST /api/auth/demo-login (default)
# entra = Microsoft Entra ID sign-in with MSAL (popup)
NEXT_PUBLIC_AUTH_MODE=demo

# Entra ID (only used when NEXT_PUBLIC_AUTH_MODE=entra)
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
# Space- or comma-separated API scopes. Default: api://<client-id>/access_as_user
NEXT_PUBLIC_ENTRA_SCOPES=

# Dev only: serve fixture data from lib/mocks.ts instead of calling the APIs.
NEXT_PUBLIC_USE_MOCKS=false
# Dev only: simulated mock latency in ms; set above 5000 to preview the "waking up" banner.
NEXT_PUBLIC_MOCK_LATENCY_MS=450
