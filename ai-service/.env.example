# --- Auth ---------------------------------------------------------------
AUTH_MODE=demo                       # demo | entra
JWT_SECRET=orderpilot-dev-secret-change-me-please-32b   # must match core-api; also signs pending actions
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=                      # e.g. api://orderpilot-api

# --- Downstream ---------------------------------------------------------
CORE_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000

# --- LLM ----------------------------------------------------------------
LLM_PROVIDER=mock                    # claude | azure_openai | mock
LLM_DAILY_BUDGET_USD=1
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Retrieval ----------------------------------------------------------
SEARCH_PROVIDER=local                # azure_ai_search | local
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=orderpilot-knowledge

LOG_LEVEL=INFO
